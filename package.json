{
  "name": "seen",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"lib/{api,auth,config,demand,security,supabase}/**/*.ts\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"lib/{api,auth,config,demand,security,supabase}/**/*.ts\" \"tests/**/*.ts\"",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.2",
    "next": "15.3.9",
    "pdfkit": "^0.19.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.3.9",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "typescript": "^5"
  }
}
