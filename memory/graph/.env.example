# Copy to memory/graph/.env and fill in. NEVER commit .env (it's gitignored).
# LLM for Graphiti ingestion extraction (this is the real cost — see README).
OPENAI_API_KEY=
# Or use Anthropic instead:
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-haiku-4-5-20251001

# Graph backend (set by docker-compose; override only for external DB).
FALKORDB_URI=redis://falkordb:6379

# Cap concurrent ingest LLM calls to control cost / avoid 429s.
SEMAPHORE_LIMIT=5
GRAPHITI_TELEMETRY_ENABLED=false
