{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/employer-listings.js": {
      "maxDuration": 60
    },
    "api/job-insights.js": {
      "maxDuration": 20
    },
    "api/optimizer.js": {
      "maxDuration": 30
    },
    "api/refresh-jobs.js": {
      "maxDuration": 300
    },
    "api/refresh-employer-boards.js": {
      "maxDuration": 300
    },
    "api/local-company-jobs.js": {
      "maxDuration": 300
    },
    "api/ingest-local-career-jobs.js": {
      "maxDuration": 60
    },
    "api/discover-sources.js": {
      "maxDuration": 300
    },
    "api/refresh-stale-jobs.js": {
      "maxDuration": 300
    },
    "api/prune-jobs.js": {
      "maxDuration": 60
    },
    "api/resume.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfjs-dist/**"
    },
    "api/apply.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfjs-dist/**"
    },
    "api/jobs.js": {
      "maxDuration": 60
    },
    "api/ingest-local-indeed.js": {
      "maxDuration": 60
    },
    "api/ingest-local-company-intel.js": {
      "maxDuration": 60
    },
    "api/local-company-intel-targets.js": {
      "maxDuration": 60
    },
    "api/admin-stats.js": {
      "maxDuration": 60
    },
    "api/admin-rescore-jobs.js": {
      "maxDuration": 300
    },
    "api/user-sync.js": {
      "maxDuration": 15
    },
    "api/demand.js": {
      "maxDuration": 60
    },
    "api/reports.js": {
      "maxDuration": 300
    },
    "api/stripe.js": {
      "maxDuration": 30
    },
    "api/outcome-followups.js": {
      "maxDuration": 60
    },
    "api/enrich-companies.js": {
      "maxDuration": 300
    },
    "api/cron-archive-reports.js": {
      "maxDuration": 300
    },
    "api/inbox-email.js": {
      "maxDuration": 60
    },
    "api/cron-search-data.js": {
      "maxDuration": 120
    },
    "api/cron-job-matches.js": {
      "maxDuration": 300
    },
    "api/interview-prep.js": {
      "maxDuration": 150
    },
    "api/optimize.js": {
      "maxDuration": 150
    }
  },
  "crons": [
    {
      "path": "/api/refresh-employer-boards",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/outcome-followups",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/employer-renewals",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/application-retention",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/refresh-jobs",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/discover-sources",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/discover-sources",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/refresh-stale-jobs",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/prune-jobs",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/demand",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/stripe?action=reconcile_all",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/reports?action=update_tenure",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/company-signals",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/enrich-companies",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron-archive-reports",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/inbox-email",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/cron-search-data",
      "schedule": "20 13 * * *"
    },
    {
      "path": "/api/cron-job-matches",
      "schedule": "5 16,22 * * *"
    }
  ]
}
