# Ignore local Claude state, but TRACK the committed session hook + settings so every
# web session boots the memory system (see .claude/hooks/session-start.sh).
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
*.local
.env
.env.*
node_modules/
.next/
tsconfig.tsbuildinfo

# Chronos memory: derived graph index is rebuildable (npm run memory:sync); secrets never committed
memory/.graph/
memory/graph/.env
!memory/graph/.env.example

# Chronos brain vault — a LOCAL working copy of the ONLINE brain (Supabase is the source of
# truth; `npm run brain:restore` rebuilds it). Untracked: it churns every board meeting, and
# tracking it is what let the builder drag the whole vault into an unrelated PR (#243). No app
# code reads memory/ at build/runtime.
memory/
