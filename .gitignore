# Ignore local Claude state, but TRACK the committed session hook + settings so every
# web session boots the memory system (see .claude/hooks/session-start.sh).
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
*.local
.env
.env.*
node_modules/
.next/
tsconfig.tsbuildinfo

# Chronos memory: derived graph index is rebuildable (npm run memory:sync); secrets never committed
memory/.graph/
memory/graph/.env
!memory/graph/.env.example
